android_app {
    name: "FaceUnlock",
    srcs: ["src/**/*.java", "src/**/*.kt"],
    asset_dirs: ["assets"],
    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-common",
        "androidx.camera_camera-core",
        "androidx.camera_camera-camera2",
        "androidx.camera_camera-lifecycle",
        "androidx.camera_camera-viewfinder",
        "androidx.compose.ui_ui",
        "androidx.compose.material3_material3",
        "androidx.compose.foundation_foundation",
        "androidx.compose.runtime_runtime",
        "androidx.activity_activity-compose",
        "setup-wizard-lib",
        "setupcompat",
        "setupdesign",
        "tensorflowlite_java",
        "tensorflow-lite-gpu",
        "tensorflow-lite-gpu-api",
        "tflite_support_java",
        "vendor.aospa.biometrics.face",
        "kotlinx-coroutines-android",
    ],

    required: [
        "default_permissions_co.aospa.sense.xml",
        "hiddenapi-whitelist-co.aospa.sense.xml",
        "privapp_whitelist_co.aospa.sense.xml",
        "FaceUnlockOverlay",
    ],

    aaptflags: [
        "-0 .tflite",
    ],

    jni_libs: [
        "libtensorflowlite_jni",
        "libtensorflowlite_gpu_jni",
        "libimage_processing_util_jni",
        "libsurface_util_jni",
    ],

    platform_apis: true,
    privileged: true,
    certificate: "platform",
    optimize: {
        enabled: false,
    },
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default_permissions_co.aospa.sense.xml",
    src: "permissions/default_permissions_co.aospa.sense.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "hiddenapi-whitelist-co.aospa.sense.xml",
    src: "permissions/hiddenapi-whitelist-co.aospa.sense.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp_whitelist_co.aospa.sense.xml",
    src: "permissions/privapp_whitelist_co.aospa.sense.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

android_library_import {
    name: "tensorflow-lite-gpu",
    aars: ["libs/tensorflow-lite-gpu.aar"],
    sdk_version: "current",
}

android_library_import {
    name: "tensorflow-lite-gpu-api",
    aars: ["libs/tensorflow-lite-gpu-api.aar"],
    sdk_version: "current",
}

cc_prebuilt_library_shared {
    name: "libimage_processing_util_jni",
    arch: {
        arm64: {
            srcs: ["libs/androidx-camera_camera-core/jni/arm64-v8a/libimage_processing_util_jni.so"],
        },
        arm: {
            srcs: ["libs/androidx-camera_camera-core/jni/armeabi-v7a/libimage_processing_util_jni.so"],
        },
        x86_64: {
            srcs: ["libs/androidx-camera_camera-core/jni/x86_64/libimage_processing_util_jni.so"],
        },
        x86: {
            srcs: ["libs/androidx-camera_camera-core/jni/x86/libimage_processing_util_jni.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libsurface_util_jni",
    arch: {
        arm64: {
            srcs: ["libs/androidx-camera_camera-core/jni/arm64-v8a/libsurface_util_jni.so"],
        },
        arm: {
            srcs: ["libs/androidx-camera_camera-core/jni/armeabi-v7a/libsurface_util_jni.so"],
        },
        x86_64: {
            srcs: ["libs/androidx-camera_camera-core/jni/x86_64/libsurface_util_jni.so"],
        },
        x86: {
            srcs: ["libs/androidx-camera_camera-core/jni/x86/libsurface_util_jni.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libtensorflowlite_gpu_jni",
    arch: {
        arm64: {
            srcs: ["libs/tensorflow-lite-gpu-jni/arm64-v8a/libtensorflowlite_gpu_jni.so"],
        },
        arm: {
            srcs: ["libs/tensorflow-lite-gpu-jni/armeabi-v7a/libtensorflowlite_gpu_jni.so"],
        },
        x86_64: {
            srcs: ["libs/tensorflow-lite-gpu-jni/x86_64/libtensorflowlite_gpu_jni.so"],
        },
        x86: {
            srcs: ["libs/tensorflow-lite-gpu-jni/x86/libtensorflowlite_gpu_jni.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
}
